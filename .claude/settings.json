{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/workflow-reminder.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)", "Bash(cut:*)", "Bash(du:*)", "Bash(echo:*)",
      "Bash(find:*)", "Bash(grep:*)", "Bash(head:*)", "Bash(ls:*)",
      "Bash(sed -n:*)", "Bash(sort:*)", "Bash(tail:*)", "Bash(uniq:*)",
      "Bash(wc:*)", "Bash(which:*)", "Bash(mkdir:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git show:*)", "Bash(git branch:*)", "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)", "Bash(git add:*)",
      "Bash(idf.py build:*)", "Bash(idf.py size:*)",
      "Bash(idf.py fullclean:*)", "Bash(idf.py reconfigure:*)",
      "Bash(kicad-cli:*)", "Bash(soffice --headless:*)", "Bash(python3:*)",
      "mcp__atlassian__addCommentToJiraIssue",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__transitionJiraIssue"
    ]
  }
}
