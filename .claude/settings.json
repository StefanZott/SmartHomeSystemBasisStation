{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/workflow-reminder.ps1"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__atlassian__addCommentToJiraIssue",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__transitionJiraIssue"
    ]
  }
}
