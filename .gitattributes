# Zeilenenden projektweit auf LF normalisieren.
# Verhindert, dass Windows-Werkzeuge im WSL-Workspace ganze Dateien auf CRLF
# umschreiben und dadurch Scheinaenderungen im Diff erzeugen.
* text=auto eol=lf

# Windows-Skripte benoetigen CRLF im Arbeitsverzeichnis.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaerformate: keine Zeilenenden-Konvertierung, kein Textdiff.
*.pdf  binary
*.png  binary
*.ico  binary
*.xlsx binary
