// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.183.0/containers/ubuntu
{
	"name": "SmartHomeBasisStation",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"idf.espIdfPath": "/opt/esp/idf",
				"idf.customExtraPaths": "",
				"idf.pythonBinPath": "/opt/esp/python_env/current/bin/python",
				"idf.toolsPath": "/opt/esp",
				"idf.gitPath": "/usr/bin/git",
				"idf.port": "/dev/ttyUSB0",
				"idf.flashType": "UART",
				"idf.adapterTargetName": "esp32s3"
			},
			"extensions": [
				"espressif.esp-idf-extension",
				"anthropic.claude-code"
			],
		},
		"codespaces": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"idf.espIdfPath": "/opt/esp/idf",
				"idf.customExtraPaths": "",
				"idf.pythonBinPath": "/opt/esp/python_env/current/bin/python",
				"idf.toolsPath": "/opt/esp",
				"idf.gitPath": "/usr/bin/git",
				"idf.port": "/dev/ttyUSB0",
				"idf.flashType": "UART",
				"idf.adapterTargetName": "esp32s3"
			},
			"extensions": [
				"espressif.esp-idf-extension"
			],
		}
	},
	"containerEnv": {
		"IDF_TARGET": "esp32s3"
	},
	"runArgs": ["--privileged", "--env-file", "${localWorkspaceFolder}/secrets/.env"],
	// secrets/.env (z. B. GITHUB_PAT fuer die MCP-Server) ist git-ignoriert und wird
	// daher nicht im Dockerfile-Image gebacken. Die Datei wird oben per --env-file
	// direkt von Docker geladen, damit die Variablen in PID 1 und damit in jedem
	// Kindprozess liegen - auch im VS-Code-Extension-Host, der Claude Code startet.
	// Der postCreateCommand unten haengt sie zusaetzlich ins .bashrc ein, damit sie
	// auch in interaktiven Terminals sichtbar sind.
	// Achtung: --env-file entfernt keine Anfuehrungszeichen, Werte daher unquoted halten.
	"postCreateCommand": "grep -qxF 'set -a; source \"${containerWorkspaceFolder}/secrets/.env\" 2>/dev/null; set +a' ~/.bashrc || echo 'set -a; source \"${containerWorkspaceFolder}/secrets/.env\" 2>/dev/null; set +a' >> ~/.bashrc"
}
